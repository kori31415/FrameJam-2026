[resource]
script = ExtResource("1_2777j")
char_name = Array[String](["Thea", "Gisela", "Thea", "Gisela", "Thea", "Gisela", "Thea", "Nadine", "Thea", "Gisela", "Thea", "Gisela", "Thea", "Gisela", "Thea", "Gisela", "Thea", "Nadine", "Thea", "Nadine", "Thea", "Nadine", "Nadine", "Nadine", "Nadine", "Thea", "Nadine", "Thea", "Nadine", "Thea", "Nadine", "Thea", "Nadine", "Thea", "Nadine", "Thea", "Nadine", "Thea", "Nadine", "Thea"])
lines = Array[String](["Guh, I’m too weak.", "What do you know about Sylvia?!", "She cursed the manor, wanted to steal its treasures.", "What is she up to with Pippin?", "I don’t know.", "Really?", "Really. I don’t even know who that is.", "Why did she transform you too?", "There’s a reason, but I’m not smart enough to figure it out.", "Did she leave you here?", "She wouldn’t abandon me like that!", "Have you seen her since the curse hit?", "… No.", "...", "Did she really just intend to leave me here?", "I’m afraid she might have.", "You’re probably right, I’m a failure. Of course she wouldn’t want to keep a ugly, useless excuse of a mage like me around.", "Hey, don’t talk about yourself like that.", "Grab your key already! Leave me alone!", "No, I’m not going to let you wallow in self hatred by yourself.", "I don’t need a self esteem lecture right now!", "I’m not going to give you one, I just want to offer some compassion.", "I don’t like myself very much either, I’m scared, I’m shy, I’m awkward and my body has felt wrong long before this curse hit. I thought I was unloveable, I never really had any friends.", "But then I took a chance on myself not long ago, I stole a maid outfit which I’d been yearning to wear for years, I experimented with make-up, I called myself Nadine for the first time.", "It didn’t fix me, but it did give me hope, let me believe there might still be a wonderful person inside me.", "I’m not transgender though, this is just me. It won’t get any better.", "I thought it wouldn’t for a long time either. But I look at you and I see so much potential, you almost had Gisela with that surprise attack, you’re certainly no slouch at magic and I’m sure there’s more I don’t know about. I’d like to be your friend.", "You’re just saying that because you pity me.", "Maybe, but if you’re supposedly so hopeless then why not try?", "What does it even matter? If you two manage to break the curse, I’ll have nowhere to go, if you don’t I’ll just be a motionless mirror forever.", "Why not join the maids here?", "As if they’d accept me.", "I know what Anja and Melanie are like, I’m sure they would welcome you.", "Are you one of them too?", "I’m not actually, I work the stables. Always wanted to join them, but I’ve been too scared to ask. Maybe we can ask them together.", "I’d like that.", "Are you feeling okay now?", "Not entirely, but it’s a bit better. You should go help your friend.", "All right, but I’ll be back for you, I promise.", "Thank you."])
metadata/_custom_type_script = "uid://butavhetddgg6"
