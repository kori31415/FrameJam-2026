char_name = Array[String](["Helga", "Gisela", "Ingrid", "Ursula", "Gisela", "Sylvia", "Helga", "Gisela", "Helga", "I'll take what I can get."])
lines = Array[String](["You sure are strong, seems Amelia’s gonna have to deal with you herself.", "I’d rather avoid more fighting.", "That’s probably going to be rather difficult.", "That’s probably going to be rather difficult.", "I’ll get to the bottom of this, I promise.", "Don’t make promises you can’t keep Gigi. False hope isn’t useful.", "Your friend is right, but I appreciate the thought.", "Do you trust us now?", "I don’t know, you don’t seem malicious at least.", "I’ll take what I can get."])
