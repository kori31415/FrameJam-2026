[resource]
script = ExtResource("1_awyol")
char_name = Array[String](["Pippin", "Gisela", "Pippin", "Nadine", "Pippin", "Gisela", "Pippin", "Gisela", "Pippin", "Gisela", "Pippin", "Gisela", "Pippin", "Gisela", "Pippin", "Gisela", "Nadine", "Pippin", "Gisela", "Pippin", "Nadine", "Pippin", "Gisela", "Pippin", "Nadine", "Gisela", "Nadine", "Yay!", "Gisela", "Pippin", "Gisela", "Gisela"])
lines = Array[String](["Arf!", "A dog? Wait… Pippin?", "Arf arf!", "Oh no! He lost his voice!", "Arf! A talking rat! Hahaha!", "Wait, dogs don’t laugh like that.", "Haha. Oh, you’re right. Oops. Sorry, I was having too much fun acting like a dog.", "Weren’t you cursed?", "Yeah, I was. But being an animal is more fun than acting like an animal. And I love dogs! They’re so fun to play with. Oh! Can you pat my head? I’ve wanted that ever so much since I became one and Amelia is too much of a grouch to do it.", "Of course. I can do that much.", "Hahaha! It feels just like when Big Sis ruffles my hair!", "Big sis? You mean Brigitte?", "Yeah! You know Big Sis, Gigi. You even have nicknames for each other.", "You know me.", "How could I forget? I got stuck in a tree, and Big Sis was so scared. But you came by and asked the tree vines to lower me to the ground. It was so cool. We’ve hung out ever since!", "I’ve known you for a while. I forgot so much.", "Young master Pippin, have you been okay in here?", "Oh yeah, I’m fine. Amelia comes in to feed me every so often. It’s fun not using a fork and knife!", "I know you’re having fun, but we’re in a really dangerous situation. Everyone in the manor is cursed, not just you Pippin.", "Oh. Is that why there’s a talking rat?", "I have a name! It’s Nadine.", "Hi Nadine! Nice to meet you.", "Wait. If Pippin isn’t in danger, then what was Sylvia telling Brigitte? Was she lying about going after Pippin?", "That witch is here? Oh no. Big Sis will try to face her alone! We can’t let her face danger like that by herself!", "It’s dangerous out there. We’ll go check, you should stay here.", "I get where you’re coming from, but Pippin will most likely be safer with us than alone in here.", "You’re right. Young master, please follow us.", "Yay!", "Is that my voice?", "Yeah! You sang with Big Sis all the time, once she played her music for you.", "It’s… beautiful.", "… Let’s go."])
metadata/_custom_type_script = "uid://butavhetddgg6"
