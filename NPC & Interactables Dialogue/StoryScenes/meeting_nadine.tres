script = ExtResource("1_e6mg7")
char_name = Array[String](["Gisela", "Gisela", "Gisela", "Gisela", "Nadine", "Gisela", "Nadine", "Gisela", "Nadine", "Gisela", "Nadine", "Gisela", "Nadine", "Gisela", "Nadine", "Gisela", "Nadine", "Gisela", "Nadine", "Gisela", "Nadine", "Gisela", "Nadine", "Gisela", "Nadine", "Gisela", "Nadine", "Gisela", "Nadine", "Gisela", "Nadine", "Gisela", "Nadine", "Gisela", "Nadine", "Gisela", "Nadine", "Gisela", "Nadine", "Gisela", "Nadine", "Gisela", "Nadine", "Gisela"])
lines = Array[String](["This place looks pretty peaceful, I need to gather my thoughts.", "Hmm, is somebody there?", "Hello?", "Ah, there you are.", "Eek!", "Are you all right? I’m not here to hurt you.", "Who are you?", "I’m Gisela.", "Nadine.", "Why were you so scared?", "I heard you beat up Anja and Melanie.", "You know them?", "They’re Helga’s two favorite maids, quite good at combat too. If you beat them then what chance do I have?", "I didn’t want to hurt them, they engaged me first, thought I or my friend were the witch. I guess they were right as it turns out.", "Oh?", "Sylvia, she told me she was my friend, I believed her, I liked her, but then we met this Brigitte person and everything I believed was apparently wrong.", "Brigitte? As in, the lady of the house Brigitte?", "I don’t know, I lost almost all of my memories.", "The beast?", "Yeah, apparently she was my lover.", "She did have one if I remember correctly.", "So it’s true. I apparently loved her and yet I can’t remember her at all, I can’t even muster up any feelings. God, I must’ve been a terrible partner.", "Don’t say that, you lost your memories, that’d have a big impact on anyone. If you two truly loved each other then surely you’ll be able to get through this.", "I don’t know, I feel completely ambivalent towards her right now.", "You barely know her right, maybe go talk to her, that might clear some things up.", "You’re right, I don’t know if I’m ready for that yet though.", "That’s fine, take all the time you need.", "What about you? What’s your deal?", "Oh, I’m just a lowly servant, nothing special.", "Do you know the people here?", "Yeah, though not personally.", "You weren’t friends with those other two?", "No, I’m not friends with them or with anyone really.", "Do you want me to be your friend?", "We don’t really know each other.", "I’m aware, but it seems like you need one and I do too if I’m being honest.", "You seem nice, I guess we can try.", "Thank you.", "So what’s your plan?", "Check on the ballroom I guess.", "So you’re ready now?", "As much as I’ll ever be.", "I’ll come with you, for emotional support.", "Heh, thanks."])
metadata/_custom_type_script = "uid://butavhetddgg6"
