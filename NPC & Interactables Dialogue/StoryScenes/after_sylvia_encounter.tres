[resource]
script = ExtResource("1_d66f7")
char_name = Array[String](["Sylvia", "Gisela", "Sylvia", "Gisela", "Brigitte", "Sylvia", "Gisela", "Sylvia", "Nadine", "Pippin", "Brigitte", "Brigitte", "Gisela", "Brigitte", "Brigitte", "Gisela", "Brigitte", "Sylvia", "Sylvia", "Gisela", "Sylvia"])
lines = Array[String](["Why do you still side with her?! What about her makes you like her?! You don’t even remember her, you shouldn’t even want to help her!", "I don’t know. But I know it feels wrong to let her die.", "Hah! How righteous. Well, you’ve won! Go on then, kill me!", "No, that doesn’t feel right either. I don’t want you to die. I don’t want anyone to die.", "Gigi…", "Hah. Right. That’s how you always were. You cared so much for life, you even let the mosquitoes bite you. I never understood that.", "Sylvia. Was there something more between us? Something that I forgot, but that you remember?", "It doesn’t matter anymore. You’ve already made your decision. I just… I didn’t want to let you go.", "Is it over? Are we safe?", "I think so.", "Gigi. Now that we have time, I can explain the curse.", "When Sylvia cursed us, she did so to prevent you from talking to me. But somehow, we’re still able to communicate and understand each other. I don’t think that’s Sylvia’s doing. I think it was you.", "Sylvia mentioned a game.", "Yeah. She called it a game. You called it a deal. She cursed Pippin, turning him into a dog. I was angry. I tried to attack her. But you stopped me, tried to find a more peaceful way to solve this.", "Gigi, you’re the one who sealed your own memories. But you’re also the one who made it so we could still talk. You trapped Sylvia so she couldn’t take you and escape, to leave us all here under her curse.", "Then, the deal. What was it?", "It was-", "Love.", "I was jealous. I wanted your attention. I figured turning that boy into an animal would be enough. I didn’t think you’d get upset over it. You know how I like playing tricks.", "Yeah, I’m beginning to see that.", "Technically, the deal is still in effect. It hasn’t been a whole week. But… I’m done. Somehow, you always win our arguments Gigi."])
metadata/_custom_type_script = "uid://butavhetddgg6"
