[resource]
script = ExtResource("1_pex8l")
char_name = Array[String](["Gisela", "Brigitte", "Gisela", "Brigitte", "Gisela", "Brigitte", "Gisela", "Brigitte", "Gisela", "Brigitte", "Gisela", "Brigitte", "Brigitte", "Brigitte", "Gisela", "Gisela", "Brigitte", "Pippin", "Nadine", "Nadine", "Nadine", "Pippin", "Nadine", "Pippin", "Nadine", "Brigitte", "Gisela", "Brigitte", "Gisela", "Brigitte", "Gisela", "Brigitte", "Gisela", "Gisela", "Brigitte", "Gisela"])
lines = Array[String](["Oh right, Brigitte! Since we’re starting over our relationship from the beginning. I wanted to know more about you.", "Oh? I’m all ears. Ask me anything.", "Well, I found this on your bed when we were looking for the key to Pippin’s room.", "Ah. Our love song.", "Our?", "Yeah. My Flower. It’s you. How warm you are, how free you are, and how your presence makes me feel warm and free too. You make me feel like home really is home as long as you’re with me.", "That’s really sweet actually.", "Do you want to listen to it? I have other tapes you can listen to if this is too much for you.", "No. I want to listen to this one.", "Okay. Then we can listen together.", "It’s beautiful, Brie.", "Yeah, it is.", "...", "Gigi?", "I remember now. I remember everything.", "I love you, Brie.", "Oh Gigi. I love you too.", "I’m human again!", "Me too!", "!!!", "Oh, … oh, I’m … a woman. *sniff* Is this real?", "Haha, yeah, why wouldn’t it be?", "I can’t explain right now *sob, but I’m so, so happy. This is all I’ve ever wanted. *sob*", "I’ll be happy too! Congratulations, Nadine!", "Thank you Pippin. *gross sobbing*", "Gigi…", "Brie…", "I never want to do that again.", "You never know. The future is always changing.", "… no, I definitely don’t want to do that again.", "*giggle* Okay. I’ll try not to involve you in any unfortunate love triangles.", "That would help immensely, my flower.", "Oh. Right. That song.", "It wasn’t just about me. I sang that thinking about you.", "*blush* You always know how to make me at a loss for words.", "Then let our actions speak instead."])
metadata/_custom_type_script = "uid://butavhetddgg6"
